# Copie este arquivo para ".env" (o .env real NÃO vai para o Git) e preencha.
# Passo a passo completo: docs/deploy-supabase-render.md

# --- Conexão da APLICAÇÃO (usuário restrito "totem_app") ---------------------
# É esta que vai no servidor (Render). Formato no Supabase (Session pooler):
#   postgresql://totem_app.SEU_PROJECT_REF:SENHA@aws-X-REGIAO.pooler.supabase.com:5432/postgres
# Dica: use uma senha só com letras e números (senão precisa "escapar" na URL).
DATABASE_URL=

# --- Conexão do ADMINISTRADOR (só no seu computador!) -----------------------
# Usada por "npm run db:setup" e "npm run operador:criar". Nunca vai para o servidor.
#   postgresql://postgres.SEU_PROJECT_REF:SENHA_DO_POSTGRES@aws-X-REGIAO.pooler.supabase.com:5432/postgres
ADMIN_DATABASE_URL=

# Senha que o usuário "totem_app" vai ter (a mesma usada em DATABASE_URL).
# Mínimo 12 caracteres, só letras, números, "_" ou "-".
APP_DB_PASSWORD=
